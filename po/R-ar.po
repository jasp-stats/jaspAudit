msgid "Bayesian Direct Estimator"
msgstr "المقدّر البايزي المباشر"

msgid "Bayesian Difference Estimator"
msgstr "مقدّر الفرق البايزي"

msgid "Bayesian Ratio Estimator"
msgstr "مقدّر النسبة البايزي"

msgid "Bayesian Regression Estimator"
msgstr "مقدّر الانحدار البايزي"

msgid "%1$s%% Credible interval"
msgstr "فترة المصداقية %1$s%%"

msgid "Posterior mode"
msgstr "المنوال البعدي"

msgid "Precision"
msgstr "الدقة"

msgid "Lower"
msgstr "الحد الأدنى"

msgid "Upper"
msgstr "الحد الأعلى"

msgid "Please specify the population size and your audit values."
msgstr "يرجى تحديد حجم المجتمع وقيم البنود بعد المراجعة."

msgid "Please specify the population size, population value and your sample variables."
msgstr "يرجى تحديد حجم المجتمع وقيمته ومتغيرات العينة."

msgid "<b>Warning.</b>"
msgstr "<b>تحذير.</b>"

msgid "The number of items in the population is lower than the number of items in the sample."
msgstr "عدد البنود في المجتمع أقل من عدد البنود في العينة."

msgid "Prior and Posterior Distribution"
msgstr "التوزيعان القبلي والبعدي"

msgid "True population value"
msgstr "القيمة الحقيقية للمجتمع"

msgid "Density"
msgstr "الكثافة"

msgid "Plotting not possible: %1$s"
msgstr "الرسم غير ممكن: %1$s"

msgid "<b>Figure %1$i.</b> The prior and posterior distribution for the true population value."
msgstr "<b>الشكل %1$i.</b> التوزيعان القبلي والبعدي للقيمة الحقيقية للمجتمع."

msgid "<u>Procedure</u>"
msgstr "<u>الإجراء</u>"

msgid "Benford's law states that in many naturally occurring collections of numerical observations, the leading significant digit is likely to be small. The goal of this procedure is to determine to what extent the first leading digits in the data set follow Benford's law, and to test this relation with a type-I error of %1$s. Data that are not distributed according to Benford's law might need further investigation."
msgstr ""
"ينص قانون بنفورد على أن الرقم الدال الأول يميل إلى أن يكون صغيرًا في مجموعات "
"كثيرة من المشاهدات العددية الطبيعية. يهدف الإجراء إلى تحديد مدى اتباع الأرقام "
"الأولى في البيانات لقانون بنفورد، واختبار ذلك بمعدل خطأ من النوع الأول %1$s. "
"قد تستدعي البيانات غير المطابقة للقانون مزيدًا من الفحص."

msgid "Benford's law states that in many naturally occurring collections of numerical observations, the leading significant digit is likely to be small. The goal of this procedure is to determine to what extent the first two leading digits in the data set follow Benford's law, and to test this relation with a type-I error of %1$s. Data that are not distributed according to Benford's law might need further investigation."
msgstr ""
"ينص قانون بنفورد على أن الرقم الدال الأول يميل إلى أن يكون صغيرًا في مجموعات "
"كثيرة من المشاهدات العددية الطبيعية. يهدف الإجراء إلى تحديد مدى اتباع أول "
"رقمين في البيانات لقانون بنفورد، واختبار ذلك بمعدل خطأ من النوع الأول %1$s. "
"قد تستدعي البيانات غير المطابقة للقانون مزيدًا من الفحص."

msgid "Benford's law states that in many naturally occurring collections of numerical observations, the leading significant digit is likely to be small. The goal of this procedure is to determine to what extent the last digits in the data set follow Benford's law, and to test this relation with a type-I error of %1$s. Data that are not distributed according to Benford's law might need further investigation."
msgstr ""
"ينص قانون بنفورد على أن الرقم الدال الأول يميل إلى أن يكون صغيرًا في مجموعات "
"كثيرة من المشاهدات العددية الطبيعية. يهدف الإجراء إلى تحديد مدى اتباع الأرقام "
"الأخيرة في البيانات لقانون بنفورد، واختبار ذلك بمعدل خطأ من النوع الأول %1$s. "
"قد تستدعي البيانات غير المطابقة للقانون مزيدًا من الفحص."

msgid "The uniform distribution assigns equal probability to all possible digits that may occur. The goal of this procedure is to determine to what extent the first leading digits in the data set follow the uniform distribution, and to test this relation with a type-I error of %1$s. If the uniform distribution assumption is desirable, then violation of uniformity is cause for further investigation."
msgstr ""
"يعطي التوزيع المنتظم احتمالًا متساويًا لجميع الأرقام الممكنة. يهدف الإجراء إلى "
"تحديد مدى اتباع الرقم الأول في البيانات لهذا التوزيع، واختبار ذلك بمعدل خطأ "
"من النوع الأول %1$s. إذا كان افتراض الانتظام مطلوبًا، فإن انتهاكه يستدعي مزيدًا "
"من الفحص."

msgid "The uniform distribution assigns equal probability to all possible digits that may occur. The goal of this procedure is to determine to what extent the first two leading digits in the data set follow the uniform distribution, and to test this relation with a type-I error of %1$s. If the uniform distribution assumption is desirable, then violation of uniformity is cause for further investigation."
msgstr ""
"يعطي التوزيع المنتظم احتمالًا متساويًا لجميع الأرقام الممكنة. يهدف الإجراء إلى "
"تحديد مدى اتباع أول رقمين في البيانات لهذا التوزيع، واختبار ذلك بمعدل خطأ من "
"النوع الأول %1$s. إذا كان افتراض الانتظام مطلوبًا، فإن انتهاكه يستدعي مزيدًا من "
"الفحص."

msgid "The uniform distribution assigns equal probability to all possible digits that may occur. The goal of this procedure is to determine to what extent the last digits in the data set follow the uniform distribution, and to test this relation with a type-I error of %1$s. If the uniform distribution assumption is desirable, then violation of uniformity is cause for further investigation."
msgstr ""
"يعطي التوزيع المنتظم احتمالًا متساويًا لجميع الأرقام الممكنة. يهدف الإجراء إلى "
"تحديد مدى اتباع الأرقام الأخيرة في البيانات لهذا التوزيع، واختبار ذلك بمعدل "
"خطأ من النوع الأول %1$s. إذا كان افتراض الانتظام مطلوبًا، فإن انتهاكه يستدعي "
"مزيدًا من الفحص."

msgid "<u>Assessing Benford's Law</u>"
msgstr "<u>تقييم قانون بنفورد</u>"

msgid "<u>Assessing the Uniform Distribution</u>"
msgstr "<u>تقييم التوزيع المنتظم</u>"

msgid "Benford's Law"
msgstr "قانون بنفورد"

msgid "Uniform Distribution"
msgstr "التوزيع المنتظم"

msgid "<b>Table %1$i.</b> Omnibus Test - %2$s"
msgstr "<b>الجدول %1$i.</b> الاختبار الشامل - %2$s"

msgid "BF%1$s"
msgstr "BF%1$s"

msgid "Log(BF%1$s)"
msgstr "Log(BF%1$s)"

msgid "MAD"
msgstr "متوسط الانحراف المطلق (MAD)"

msgid "df"
msgstr "درجات الحرية"

msgid "Benford's law"
msgstr "قانون بنفورد"

msgid "the uniform distribution"
msgstr "التوزيع المنتظم"

msgid "The null hypothesis specifies that the first digits (1 - 9) in the data set are distributed according to %1$s."
msgstr ""
"تنص الفرضية الصفرية على أن الأرقام الأولى (1 - 9) في مجموعة البيانات موزعة وفق "
"%1$s."

msgid "The null hypothesis specifies that the first two digits (10 - 99) in the data set are distributed according to %1$s."
msgstr ""
"تنص الفرضية الصفرية على أن الرقمين الأولين (10 - 99) في مجموعة البيانات "
"موزعان وفق %1$s."

msgid "The null hypothesis specifies that the last digits (1 - 9) in the data set are distributed according to %1$s."
msgstr ""
"تنص الفرضية الصفرية على أن الأرقام الأخيرة (1 - 9) في مجموعة البيانات موزعة "
"وفق %1$s."

msgid "The Bayes factor is computed using a Dirichlet(%1$s,...,%2$s%3$s) prior with %2$s = %4$s."
msgstr ""
"يُحسب عامل بايز باستخدام توزيع قبلي Dirichlet(%1$s,...,%2$s%3$s)، حيث %2$s = "
"%4$s."

msgid "<b>Warning.</b> The <i>p</i>-value may be unreliable due to some expected counts being lower than 5."
msgstr ""
"<b>تحذير.</b> قد لا تكون قيمة <i>p</i> موثوقة لأن بعض التكرارات المتوقعة أقل "
"من 5."

msgid "<b>Table %1$i.</b> Frequency Table"
msgstr "<b>الجدول %1$i.</b> جدول التكرارات"

msgid "Leading digit"
msgstr "الرقم الأول"

msgid "Leading digits"
msgstr "الأرقام الأولى"

msgid "Last digit"
msgstr "الرقم الأخير"

msgid "Uniform distribution"
msgstr "التوزيع المنتظم"

msgid "Count"
msgstr "العدد"

msgid "Relative frequency"
msgstr "التكرار النسبي"

msgid "%1$s%% Confidence Interval"
msgstr "فترة الثقة %1$s%%"

msgid "Expected count"
msgstr "العدد المتوقع"

msgid "The null hypothesis specifies that the relative frequency of a digit is equal to its expected relative frequency under %1$s."
msgstr ""
"تنص الفرضية الصفرية على أن التكرار النسبي للرقم يساوي تكراره النسبي المتوقع "
"تحت %1$s."

msgid "Bayes factors are computed using a beta(1, 1) prior."
msgstr "تُحسب عوامل بايز باستخدام التوزيع القبلي beta(1, 1)."

msgid "Confidence intervals and <i>p</i>-values are based on independent binomial distributions."
msgstr "تستند فترات الثقة وقيم <i>p</i> إلى توزيعات ذي حدين مستقلة."

msgid "The <i>p</i>-values are based on independent binomial distributions."
msgstr "تستند قيم <i>p</i> إلى توزيعات ذي حدين مستقلة."

msgid "Leading Digit"
msgstr "الرقم الأول"

msgid "Leading Digits"
msgstr "الأرقام الأولى"

msgid "Last Digit"
msgstr "الرقم الأخير"

msgid "<b>Table %1$i.</b> Rows Matched to %2$s %3$s"
msgstr "<b>الجدول %1$i.</b> الصفوف المطابقة لـ%2$s %3$s"

msgid "Row"
msgstr "الصف"

msgid "Value"
msgstr "القيمة"

msgid "The requested digit must be between 1 - 9."
msgstr "ويجب أن يكون الرقم المطلوب بين 1-9."

msgid "The requested digit must be between 10 - 99."
msgstr "ويجب أن يكون الرقم المطلوب بين 10 و99."

msgid "Displayed values are rounded to the number of decimals set in the global preferences."
msgstr ""
"تُقرَّب القيم المعروضة إلى عدد المنازل العشرية المحدد في التفضيلات العامة."

msgid "Observed vs. Expected Relative Frequencies"
msgstr "التكرارات النسبية المشاهدة مقابل المتوقعة"

msgid "<b>Figure %1$i.</b> The observed relative frequencies of each digit in the data set compared to the expected relative frequencies under %2$s. For data sets distributed according %2$s the blue dots will lie near the top of the grey bars."
msgstr ""
"<b>الشكل %1$i.</b> التكرارات النسبية المشاهدة لكل رقم في البيانات مقارنةً "
"بالمتوقعة تحت %2$s. للبيانات الموزعة وفق %2$s، تقع النقاط الزرقاء قرب قمم "
"الأعمدة الرمادية."

msgid "Bayes Factor Robustness Plot"
msgstr "مخطط متانة عامل بايز"

msgid "<b>Figure %1$i.</b> The results of a robustness check using the Bayes factor. The figure illustrates the impact of different specifications (i.e., concentration parameters) of the Dirichlet prior on the Bayes factor values, providing insights into the robustness of the statistical evidence to the choice of prior distribution."
msgstr ""
"<b>الشكل %1$i.</b> نتائج فحص المتانة باستخدام عامل بايز. يوضح الشكل أثر "
"التحديدات المختلفة (أي معلمات التركيز) لتوزيع ديريشليه القبلي في قيم عامل "
"بايز، بما يبيّن متانة الدليل الإحصائي تجاه اختيار التوزيع القبلي."

msgid "Sequential Analysis Plot"
msgstr "مخطط التحليل التتابعي"

msgid "<b>Figure %1$i.</b> The results of a sequential analysis using the Bayes factor. The figure provides insight into how the statistical evidence from these data accumulates over time and under different prior specifications."
msgstr ""
"<b>الشكل %1$i.</b> نتائج تحليل متتابع باستخدام عامل بايز. يوضح الشكل تراكم "
"الدليل الإحصائي من هذه البيانات بمرور الزمن وتحت توصيفات مختلفة للتوزيع "
"القبلي."

msgid "<u>Conclusion</u>"
msgstr "<u>الاستنتاج</u>"

msgid "is rejected"
msgstr "رُفضت"

msgid "is not rejected"
msgstr "لم تُرفض"

msgid "%1$s < %2$s"
msgstr "%1$s < %2$s"

msgid "%1$s >= %2$s"
msgstr "%1$s >= %2$s"

msgid "The <i>p</i>-value is %1$s and the null hypothesis that the first digits in the data set are distributed according to %2$s %3$s."
msgstr ""
"قيمة <i>p</i> هي %1$s. %3$s الفرضية الصفرية القائلة إن الأرقام الأولى في "
"مجموعة البيانات موزعة وفق %2$s."

msgid "The <i>p</i>-value is %1$s and the null hypothesis that the first two digits in the data set are distributed according to %2$s %3$s."
msgstr ""
"قيمة <i>p</i> هي %1$s. %3$s الفرضية الصفرية القائلة إن الرقمين الأولين في "
"مجموعة البيانات موزعان وفق %2$s."

msgid "The <i>p</i>-value is %1$s and the null hypothesis that the last digits in the data set are distributed according to %2$s %3$s."
msgstr ""
"قيمة <i>p</i> هي %1$s. %3$s الفرضية الصفرية القائلة إن الأرقام الأخيرة في "
"مجموعة البيانات موزعة وفق %2$s."

msgid "%1$s The Bayes factor indicates that the data are %2$s times more likely to occur under the null hypothesis than under the alternative hypothesis."
msgstr ""
"%1$s يشير عامل بايز إلى أن احتمال ظهور البيانات تحت الفرضية الصفرية يساوي "
"%2$s ضعف احتمال ظهورها تحت الفرضية البديلة."

msgid "Direct Estimator"
msgstr "المقدّر المباشر"

msgid "Difference Estimator"
msgstr "مقدّر الفروق"

msgid "Ratio Estimator"
msgstr "مقدّر النسبة"

msgid "Regression Estimator"
msgstr "مقدّر الانحدار"

msgid "Point estimate"
msgstr "التقدير النقطي"

msgid "%1$s%% Confidence interval"
msgstr "فترة الثقة %1$s%%"

msgid "The displayed numbers are exact and may differ slightly from the rounded numbers in the explanatory text."
msgstr ""
"قد تختلف الأعداد المعروضة بدقة اختلافًا طفيفًا عن الأعداد المقرّبة في النص "
"التفسيري."

msgid "<u>Calculations</u>"
msgstr "<u>الحسابات</u>"

msgid "<i>The required information for the <b>direct</b> estimator consists of:</i>"
msgstr "<i>تتكوّن المعلومات المطلوبة للمقدّر <b>المباشر</b> من:</i>"

msgid "The population size <i>N</i>"
msgstr "حجم المجتمع <i>N</i>"

msgid "%1$s = %2$i"
msgstr "%1$s = %2$i"

msgid "The sample size <i>n</i>"
msgstr "حجم العينة <i>n</i>"

msgid "The mean of the sample audit values %1$s"
msgstr "متوسط قيم العينة بعد المراجعة %1$s"

msgid "%1$s = %2$s"
msgstr "%1$s = %2$s"

msgid "The standard deviation of the sample audit values %1$s"
msgstr "الانحراف المعياري لقيم العينة بعد المراجعة %1$s"

msgid "The t-value <i>(df = n - 1)</i> corresponding to %1$s%% confidence %2$s%3$s%4$s"
msgstr ""
"قيمة t بدرجات حرية <i>(df = n - 1)</i> المقابلة لثقة بنسبة %1$s%% "
"%2$s%3$s%4$s"

msgid "The t-value <i>(df = %1$s - 1)</i> corresponding to %2$s%% confidence %3$s%4$s%5$s%6$s"
msgstr ""
"قيمة t بدرجات حرية <i>(df = %1$s - 1)</i> المقابلة لثقة بنسبة %2$s%% "
"%3$s%4$s%5$s%6$s"

msgid "%1$s\n                                %2$s\n                                %3$s\n                                %4$s\n                                %5$s"
msgstr ""
"%1$s\n"
"                                %2$s\n"
"                                %3$s\n"
"                                %4$s\n"
"                                %5$s"

msgid "<i>This information allows for calculation of:</i>"
msgstr "<i>وتتيح هذه المعلومات حساب ما يلي:</i>"

msgid "The point estimate of the true population value %1$s"
msgstr "التقدير النقطي للقيمة الحقيقية للمجتمع %1$s"

msgid "The precision of the estimator %1$s%2$s%3$s"
msgstr "دقة المقدّر %1$s%2$s%3$s"

msgid "The confidence interval around the point estimate %1$s"
msgstr "فترة الثقة حول التقدير النقطي %1$s"

msgid "%1$s = %2$s %3$s %4$s"
msgstr "%1$s = %2$s %3$s %4$s"

msgid "%1$s\n                           %2$s\n                           %3$s"
msgstr ""
"%1$s\n"
"                           %2$s\n"
"                           %3$s"

msgid "<i>The required information for the <b>difference</b> estimator consists of:</i>"
msgstr "<i>تتكوّن المعلومات المطلوبة لمقدّر <b>الفروق</b> من:</i>"

msgid "The sum of the population book values <i>B</i>"
msgstr "مجموع القيم الدفترية للمجتمع <i>B</i>"

msgid "The mean of the sample errors %1$s"
msgstr "متوسط أخطاء العينة %1$s"

msgid "The standard deviation of the sample errors %1$s"
msgstr "الانحراف المعياري لأخطاء العينة %1$s"

msgid "%1$s\n                                %2$s\n                                %3$s\n                                %4$s\n                                %5$s\n                                %6$s"
msgstr ""
"%1$s\n"
"                                %2$s\n"
"                                %3$s\n"
"                                %4$s\n"
"                                %5$s\n"
"                                %6$s"

msgid "%1$s\n                            %2$s\n                            %3$s"
msgstr ""
"%1$s\n"
"                            %2$s\n"
"                            %3$s"

msgid "<i>The required information for the <b>ratio</b> estimator consists of:</i>"
msgstr "<i>تتكوّن المعلومات المطلوبة لمقدّر <b>النسبة</b> من:</i>"

msgid "The mean of the sample book values %1$s"
msgstr "متوسط القيم الدفترية للعينة %1$s"

msgid "The standard deviation of the sample book values %1$s"
msgstr "الانحراف المعياري للقيم الدفترية للعينة %1$s"

msgid "The correlation coefficient of the sample book values and audit values %1$s"
msgstr "معامل الارتباط بين القيم الدفترية وقيم ما بعد المراجعة في العينة %1$s"

msgid "The correctness ratio %1$s"
msgstr "نسبة الصحة %1$s"

msgid "%1$s\n                                %2$s\n                                %3$s\n                                %4$s\n                                %5$s\n                                %6$s\n                                %7$s\n                                %8$s\n                                %9$s\n                                %10$s"
msgstr ""
"%1$s\n"
"                                %2$s\n"
"                                %3$s\n"
"                                %4$s\n"
"                                %5$s\n"
"                                %6$s\n"
"                                %7$s\n"
"                                %8$s\n"
"                                %9$s\n"
"                                %10$s"

msgid "<i>The required information for the <b>regression</b> estimator consists of:</i>"
msgstr "<i>تتكوّن المعلومات المطلوبة لمقدّر <b>الانحدار</b> من:</i>"

msgid "The regression coefficient of the sample book values and audit values %1$s"
msgstr "معامل الانحدار بين القيم الدفترية وقيم ما بعد المراجعة في العينة %1$s"

msgid "%1$s\n                                %2$s\n                                %3$s\n                                %4$s\n                                %5$s\n                                %6$s\n                                %7$s\n                                %8$s\n                                %9$s"
msgstr ""
"%1$s\n"
"                                %2$s\n"
