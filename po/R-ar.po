"                                %4$s\n"
"                                %5$s\n"
"                                %6$s\n"
"                                %7$s\n"
"                                %8$s\n"
"                                %9$s"

msgid "Required Sample Size"
msgstr "حجم العينة المطلوب"

msgid "Achieved precision"
msgstr "الدقة المحققة"

msgid "Current <i>n</i>"
msgstr "حجم العينة الحالي <i>n</i>"

msgid "Required precision"
msgstr "الدقة المطلوبة"

msgid "Required <i>n</i>"
msgstr "حجم العينة المطلوب <i>n</i>"

msgid "Additional <i>n</i>"
msgstr "<i>n</i> إضافي"

msgid "Scatter Plot"
msgstr "مخطط الانتشار"

msgid "Book value"
msgstr "القيمة الدفترية"

msgid "Audit value"
msgstr "القيمة بعد المراجعة"

msgid "<b>Figure %1$i.</b> Scatter plot of the book values in the selection and their audit values. Red dots indicate observations that did not match their original book value. If these red dots lie in the bottom part of the graph, the book values are overstated. If these red dots lie in the upper part of the graph, they are understated. The value <i>r</i> is the Pearson correlation coefficient of the book values and the audit values, an indicator of the strength of the linear relationship between the two variables."
msgstr ""
"<b>الشكل %1$i.</b> مخطط تشتت للقيم الدفترية للبنود المختارة وقيمها بعد "
"المراجعة. تشير النقاط الحمراء إلى البنود التي تختلف قيمها بعد المراجعة عن "
"قيمها الدفترية الأصلية. تكون القيمة الدفترية مبالغًا فيها عندما تتجاوز قيمة "
"البند بعد المراجعة، وتكون أقل من القيمة الحقيقية عندما تقل عنها. يمثّل <i>r</"
"i> معامل ارتباط بيرسون بين القيم الدفترية والقيم بعد المراجعة، ويدل على قوة "
"العلاقة الخطية بينهما."

