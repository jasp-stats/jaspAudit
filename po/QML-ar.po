msgstr "التوزيعان القبلي والبعدي"

msgctxt "PlanningOutput|"
msgid ""
"Produces a table that shows statistics for the prior distribution and the "
"posterior distribution."
msgstr "يُنتج جدولاً يبين الإحصاءات المتعلقة بالتوزيع القبلي والتوزيع البعدي."

msgctxt "PlanningOutput|"
msgid "Descriptive statistics"
msgstr "الإحصاءات الوصفية"

msgctxt "PlanningOutput|"
msgid ""
"Produces a table showing descriptive statistics of the *Book Value* column "
"in the data set."
msgstr ""
"إنشاء جدول بالإحصاءات الوصفية لعمود *القيمة الدفترية* في مجموعة البيانات."

msgctxt "PlanningOutput|"
msgid "Plots"
msgstr "المخططات"

msgctxt "PlanningOutput|"
msgid "Add additional figures about the planning to the report."
msgstr "إضافة أشكال عن التخطيط إلى التقرير."

msgctxt "PlanningOutput|"
