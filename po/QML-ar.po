msgstr "عرض الأرقام كوحدات نقدية."

msgctxt "DownloadReport|"
msgid "<b>Download Report</b>"
msgstr "<b>تنزيل التقرير</b>"

msgctxt "Confidence|"
msgid "Confidence"
msgstr "الثقة"

msgctxt "Confidence|"
msgid ""
"The confidence level used. The confidence level is the complement of the "
"audit risk: the risk that the user is willing to take to give an incorrect "
"judgment about the population. For example, if you want to use an audit risk "
"of 5%, this equals 95% confidence."
msgstr ""
"مستوى الثقة المستخدم. مستوى الثقة هو متمم مخاطر المراجعة: احتمال الخطأ الذي "
"يقبل المستخدم تحمله عند الحكم على المجتمع. مثلًا، تعادل مخاطر مراجعة 5% مستوى "
"ثقة 95%."

msgctxt "Estimator|"
msgid "Method"
msgstr "الطريقة"

msgctxt "Estimator|"
msgid "The type of method used to estimate the true value of the population."
msgstr "نوع الطريقة المستخدمة لتقدير القيمة الحقيقية للمجتمع."

msgctxt "Estimator|"
msgid "Direct estimator"
msgstr "المقدّر المباشر"

msgctxt "Estimator|"
msgid "The Bayesian direct estimator."
msgstr "المقدّر المباشر البايزي."

msgctxt "Estimator|"
msgid "Difference estimator"
msgstr "مقدِّر الفرق"

msgctxt "Estimator|"
msgid "The Bayesian difference estimator."
msgstr "مقدِّر الفرق البايزي."

msgctxt "Estimator|"
msgid "Ratio estimator"
msgstr "مقدّر النسبة"

msgctxt "Estimator|"
msgid "The Bayesian ratio estimator."
msgstr "مقدّر النسبة البايزي."

msgctxt "Estimator|"
msgid "Regression estimator"
msgstr "مقدّر الانحدار"

msgctxt "Estimator|"
msgid "The Bayesian regression estimator."
msgstr "مقدّر الانحدار البايزي."

