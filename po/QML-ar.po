msgstr "المجتمع (مطلوب)"

msgctxt "Population|"
msgid "No. items"
msgstr "عدد البنود"

msgctxt "Population|"
msgid "The total number of items (rows) in the population."
msgstr "العدد الإجمالي للبنود (الصفوف) في المجتمع."

msgctxt "Population|"
msgid "No. units"
msgstr "عدد الوحدات"

msgctxt "Population|"
msgid ""
"The total number of units in the population. Note that the units can be "
"items (rows) or monetary units (values) depending on the audit question."
msgstr ""
