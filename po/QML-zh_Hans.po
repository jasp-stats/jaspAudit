msgstr "高级"

msgctxt "auditClassicalNumberBunching|"
msgid "Adjust advanced options for this analysis."
msgstr "调整此分析的高级选项。"

msgctxt "auditClassicalNumberBunching|"
msgid "Bootstrap"
msgstr "自助法"

msgctxt "auditClassicalNumberBunching|"
msgid "Options related to the bootstrapping procedure of the p-value."
msgstr "与 p-值的自助抽样过程相关的选项。"

msgctxt "auditClassicalNumberBunching|"
msgid "The number of samples to use for simulating the p value."
msgstr "用于模拟 p 值的样本数。"

msgctxt "auditClassicalNumberBunching|"
msgid ""
"Selects the seed for the random number generator in order to reproduce "
"results."
msgstr "选择随机数生成器的种子以复现结果。"

msgctxt "auditClassicalPlanning|"
msgid "Report"
msgstr "报告"

msgctxt "auditClassicalPlanning|"
msgid "Advanced"
msgstr "高级"

