msgctxt "auditClassicalNumberBunching|"
msgid "Compute the entropy of the data."
msgstr "データのエントロピーを計算します。"

msgctxt "auditClassicalNumberBunching|"
msgid "Indicate which decimals are shuffled in the analysis."
msgstr "分析で並べ替える小数部の桁を指定します。"

msgctxt "auditClassicalNumberBunching|"
msgid "Last decimal digit is shuffled."
msgstr "小数の末尾1桁を並べ替えます。"

msgctxt "auditClassicalNumberBunching|"
msgid "Last two decimal digits are shuffled."
msgstr "小数の末尾2桁を並べ替えます。"

msgctxt "auditClassicalNumberBunching|"
msgid "All decimal digits are shuffled."
msgstr "小数のすべての桁を並べ替えます。"

