msgstr "Ajustez les options avancées pour cette analyse."

msgctxt "auditClassicalNumberBunching|"
msgid "Bootstrap"
msgstr "Bootstrap"

msgctxt "auditClassicalNumberBunching|"
msgid "Options related to the bootstrapping procedure of the p-value."
msgstr "Options relatives à la procédure de bootstrap de la valeur p."

msgctxt "auditClassicalNumberBunching|"
msgid "The number of samples to use for simulating the p value."
msgstr "Le nombre d'échantillons à utiliser pour simuler la valeur p."

msgctxt "auditClassicalNumberBunching|"
